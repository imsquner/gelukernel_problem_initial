// Local test main — runs the first test case
// Usage: ./gelu_custom

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t input_x_0_shape[] = {32};
    TensorInfo input_x_tensors[] = {{input_x_0_shape, 1, 1}};
    TensorGroupInfo info_input_x = {input_x_tensors, 1};
    int64_t output_0_shape[] = {32};
    TensorInfo output_tensors[] = {{output_0_shape, 1, 1}};
    TensorGroupInfo info_output = {output_tensors, 1};



    uint8_t *inputHost_input_x = nullptr, *inputDevice_input_x = nullptr;

    uint8_t *outputHost_output = nullptr, *outputDevice_output = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_input_x, 64));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_input_x, 64, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/input_x.bin", 64, inputHost_input_x, 64));
    ACL_CHECK(aclrtMemcpy(inputDevice_input_x, 64, inputHost_input_x, 64, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_output, 64));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_output, 64, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_input_x, info_input_x, (GM_ADDR)outputDevice_output, info_output, availableCoreNum, stream);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    ACL_CHECK(aclrtMemcpy(outputHost_output, 64, outputDevice_output, 64, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/output.bin", outputHost_output, 64));

    if (inputDevice_input_x) aclrtFree(inputDevice_input_x);
    if (inputHost_input_x) aclrtFreeHost(inputHost_input_x);
    if (outputDevice_output) aclrtFree(outputDevice_output);
    if (outputHost_output) aclrtFreeHost(outputHost_output);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
